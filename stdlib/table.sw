// ===========================================================================
// std/table —— 文本表格格式化
//
// 用法：
//   import { format_table } from "std/table";
//   const rows = [["a", "1"], ["bb", "22"]];
//   const text = format_table(["名字", "数量"], rows);
//   // 名字  数量
//   // ----  ----
//   // a     1
//   // bb    22
//
// 列宽按内容自动对齐（左对齐、空格分隔），表头下自动加分隔线。
// ===========================================================================

/// 格式化表格：headers 为 string[]，rows 为 string[][]；
/// 返回对齐后的文本（含表头与分隔线，行尾换行）。
export extern c function format_table(headers: string[], rows: string[][]): string;

// ---------------------------------------------------------------------------
// 中文函数名（转发到英文实现，火山风格命名）
// ---------------------------------------------------------------------------

export function 格式化表格(headers: string[], rows: string[][]): string {
    return format_table(headers, rows);
}
